APP_NAME=Fluxa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://fluxa.test
APP_TIMEZONE=Asia/Jakarta

# Host yang melayani landing, login, billing, dan halaman undangan.
# Seluruh host lain yang berakhiran domain ini diperlakukan sebagai
# subdomain tenant oleh InitializeTenancyBySubdomain.
CENTRAL_DOMAIN=fluxa.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fluxa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Titik di depan membuat cookie sesi berlaku di central domain DAN semua
# subdomain tenant, sehingga login sekali cukup. Konsekuensinya: cookie
# tidak memisahkan tenant sama sekali - pemisahan itu tugas middleware
# keanggotaan, bukan sesi.
SESSION_DOMAIN=.fluxa.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://fluxa.test/auth/google/callback

# Perekam request Inertia. Dimatikan karena ia menulis satu berkas per
# request ke storage/inertia-devtools sebagai user web server, sehingga
# folder itu jadi tidak terbaca oleh user pengembang dan menumpuk.
INERTIA_DEVTOOLS_ENABLED=false
